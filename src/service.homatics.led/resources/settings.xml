<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<settings version="1">

    <section id="service.homatics.led">

        <category id="led" label="32050">
            <group id="1">
                <setting id="led_status_enabled" type="boolean" label="32051">
                    <level>0</level>
                    <default>true</default>
                    <control type="toggle"/>
                </setting>
                <!-- [CoreELEC-IL] Internal bookkeeping only — not shown to
                     the user. Lets led_status_mixin.py auto-disable
                     led_status_enabled exactly once on devices without the
                     LED chip (e.g. PCs, other streamer boxes), so the
                     toggle above doesn't show "on" on hardware where the
                     feature can never actually do anything. -->
                <setting id="led_hw_autodetect_done" type="boolean" label="32051">
                    <level>0</level>
                    <default>false</default>
                    <visible>false</visible>
                </setting>
                <setting id="led_idle_mode" type="integer" label="32052">
                    <level>0</level>
                    <default>0</default>
                    <constraints>
                        <options>
